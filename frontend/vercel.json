{
  "framework": "nextjs",
  "buildCommand": "corepack pnpm run build",
  "outputDirectory": ".next",
  "devCommand": "corepack pnpm run dev",
  "installCommand": "corepack prepare pnpm@12.6.0 --activate && corepack pnpm install --frozen-lockfile",
  "regions": ["iad1"],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    }
  ]
}
