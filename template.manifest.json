{
  "version": 2,
  "$comment": "Feature map read by packages/create-nest-next-auth. Entries with \"status\": \"planned\" are not offered by the CLI. Entries with \"kind\": \"hidden\" come in through another feature's \"requires\" instead of being picked directly. Files and env vars listed here are deleted from a generated project when the feature is not selected. A path may sit under a directory another feature claims, as the provider strategies do under oauth-core; what a path may not do is belong to a feature that is still needed once this one is gone. Lines shared code needs only for one feature carry a `// feature:<id>` marker instead; see the CLI README. A target or shared module owns its files and workspaces: they are deleted when it is not part of the plan, and a planned target is never part of one. The Expo app has been built and run on an iOS simulator against the real server; Android has not been built or run. The bare React Native app only bundles, so it stays planned. A target id or shared id is also a marker name: feature:native-core marks lines that any mobile app needs. A database id is one too: feature:postgres marks lines only the PostgreSQL adapter needs, and they are removed while that database is planned.",
  "targets": {
    "web": {
      "label": "Web app (Next.js)",
      "default": true,
      "files": [],
      "workspaces": [],
      "envFiles": []
    },
    "native-expo": {
      "label": "Mobile app, Expo (iOS simulator only, Android not verified)",
      "description": "Built and run on an iOS simulator against the real server. Android has not been built or run.",
      "default": false,
      "files": ["mobile/expo/**"],
      "workspaces": ["mobile/expo"],
      "requires": { "shared": ["native-core"], "targets": [] },
      "needsSignInSite": true
    },
    "native-cli": {
      "label": "Mobile app, React Native CLI",
      "description": "Runs on an iOS simulator from a native project you generate. Android has not been built.",
      "default": false,
      "status": "planned",
      "files": ["mobile/cli/**"],
      "workspaces": ["mobile/cli"],
      "requires": { "shared": ["native-core"] },
      "needsSignInSite": true
    }
  },
  "shared": {
