# Docker environment configuration template.
# Copy to .env.docker and customize values.

# Application
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# MongoDB
MONGO_DATABASE=authboiler
MONGO_USERNAME=admin
MONGO_PASSWORD=your-mongo-password
MONGO_URI=mongodb://mongodb:27017/authboiler?replicaSet=rs0&w=majority

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=60

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASS=your-smtp-password
EMAIL_FROM=noreply@example.com

# Bcrypt
BCRYPT_ROUNDS=10

# Session
SESSION_COOKIE_NAME=sid
SESSION_COOKIE_MAX_AGE=604800000
AUTH_EPOCH=1
AUTH_NATIVE_ENABLED=false
# Require DPoP-bound token pairs after clients have upgraded. Default: false.
AUTH_NATIVE_DPOP_REQUIRED=false
# HMAC secret for DPoP nonce generation. Required when native sign-in is enabled.
# Generate with: openssl rand -hex 32
AUTH_NATIVE_DPOP_NONCE_SECRET=
# Public origin of this API, as native clients reach it. Required when native
# sign-in is enabled. Docker publishes the API on port 5000.
# API_URL=http://localhost:5000
# JSON array of native clients. Optional allowedScopes defaults to ["api"].
# With native sign-in on, an unset or empty list disables every native application and signs its users out.
# AUTH_NATIVE_APPLICATIONS='[{"clientId":"com.example.mobile","displayName":"Example Mobile","redirectUris":["com.example.mobile://oauth/callback"]}]'
# Custom-scheme native callbacks (myapp://...) in production. Default: false.
# Outside production custom schemes are always accepted. In production they are
# accepted only when this is true; https and loopback http callbacks always work.
# AUTH_NATIVE_ALLOW_CUSTOM_SCHEME=false

# Activation codes
ACTIVATION_CODE_EXPIRES_IN=900000
ACTIVATION_MAX_ATTEMPTS=5

# Password sign-in
AUTH_PASSWORD_ENABLED=true

# Magic link sign-in - needs SMTP_HOST and EMAIL_FROM
MAGIC_LINK_ENABLED=true
# Magic link lifetime in milliseconds
MAGIC_LINK_EXPIRES_IN=900000
# Magic links mailed to one address per hour
MAGIC_LINK_MAX_PER_HOUR=5

# TOTP two-factor - see docs/setup/setup-two-factor.md
TWO_FACTOR_ENABLED=true
# 32 bytes of base64, from `openssl rand -base64 32`. Required before any
# account can turn a second factor on. Changing it locks out every enrolled app.
TOTP_ENCRYPTION_KEY=

# Passkeys (WebAuthn) - see docs/setup/setup-passkeys.md
PASSKEYS_ENABLED=true
# Domain the credentials are bound to, a bare hostname with no scheme and no
# port. Defaults to the hostname of CLIENT_URL. Changing it invalidates every
# passkey already registered.
WEBAUTHN_RP_ID=
# Name shown in the browser prompt. Defaults to the app name.
WEBAUTHN_RP_NAME=
# Origin the browser has to be on. Defaults to the origin of CLIENT_URL, and
# has to be https outside localhost.
WEBAUTHN_ORIGIN=

# Swagger
SWAGGER_ENABLED=false

# Google OAuth
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/oauth/google/callback

# Facebook OAuth
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=
OAUTH_FACEBOOK_CALLBACK_URL=http://localhost:5000/api/auth/oauth/facebook/callback

# GitHub OAuth
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/oauth/github/callback

# Microsoft OAuth
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_MICROSOFT_CALLBACK_URL=http://localhost:5000/api/auth/oauth/microsoft/callback
OAUTH_MICROSOFT_TENANT=common

# Apple OAuth
# Apple refuses localhost redirect URIs. Point the callback at an HTTPS host.
# The private key is the .p8 file on one line, with newlines written as \n.
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_CALLBACK_URL=
OAUTH_APPLE_TEAM_ID=
OAUTH_APPLE_KEY_ID=
OAUTH_APPLE_PRIVATE_KEY=

# Discord OAuth
OAUTH_DISCORD_CLIENT_ID=
OAUTH_DISCORD_CLIENT_SECRET=
OAUTH_DISCORD_CALLBACK_URL=http://localhost:5000/api/auth/oauth/discord/callback

# LinkedIn OAuth
OAUTH_LINKEDIN_CLIENT_ID=
OAUTH_LINKEDIN_CLIENT_SECRET=
OAUTH_LINKEDIN_CALLBACK_URL=http://localhost:5000/api/auth/oauth/linkedin/callback

# GitLab OAuth
# Point the base URL at your own host for a self-managed instance.
OAUTH_GITLAB_CLIENT_ID=
OAUTH_GITLAB_CLIENT_SECRET=
OAUTH_GITLAB_CALLBACK_URL=http://localhost:5000/api/auth/oauth/gitlab/callback
OAUTH_GITLAB_BASE_URL=https://gitlab.com

# X OAuth
# The address only comes back with the users.email scope, which has to be
# enabled on the app.
OAUTH_X_CLIENT_ID=
OAUTH_X_CLIENT_SECRET=
OAUTH_X_CALLBACK_URL=http://localhost:5000/api/auth/oauth/x/callback

# Slack OAuth
OAUTH_SLACK_CLIENT_ID=
OAUTH_SLACK_CLIENT_SECRET=
OAUTH_SLACK_CALLBACK_URL=http://localhost:5000/api/auth/oauth/slack/callback

# Twitch OAuth
OAUTH_TWITCH_CLIENT_ID=
OAUTH_TWITCH_CLIENT_SECRET=
OAUTH_TWITCH_CALLBACK_URL=http://localhost:5000/api/auth/oauth/twitch/callback

# Generic OpenID Connect
# Endpoints are read from {issuer}/.well-known/openid-configuration at startup.
# An unreachable issuer leaves this provider off; it does not stop the boot.
OAUTH_OIDC_ISSUER=
OAUTH_OIDC_CLIENT_ID=
OAUTH_OIDC_CLIENT_SECRET=
OAUTH_OIDC_CALLBACK_URL=http://localhost:5000/api/auth/oauth/oidc/callback
OAUTH_OIDC_PROVIDER_ID=oidc
OAUTH_OIDC_DISPLAY_NAME=Single sign-on
OAUTH_OIDC_SCOPES=openid profile email
# Set all four to skip discovery, for an issuer that publishes no document.
OAUTH_OIDC_AUTHORIZATION_URL=
OAUTH_OIDC_TOKEN_URL=
OAUTH_OIDC_USERINFO_URL=
OAUTH_OIDC_JWKS_URL=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:5000
