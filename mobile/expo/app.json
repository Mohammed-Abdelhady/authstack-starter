{
  "expo": {
    "name": "Mobile Expo",
    "slug": "mobile-expo",
    "version": "0.1.0",
    "scheme": "com.example.mobile",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android"],
    "ios": {
      "bundleIdentifier": "com.example.mobileexpo",
      "infoPlist": {
        "CFBundleLocalizations": ["en", "ar"]
      }
    },
    "android": {
      "package": "com.example.mobileexpo"
    },
    "plugins": ["expo-secure-store", "expo-web-browser", "./plugins/with-scene-lifecycle"]
  }
}
