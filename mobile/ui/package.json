{
  "name": "@app/native-ui",
  "version": "0.1.0",
  "description": "Sign-in, account and sessions screens for the mobile shells, over the sign-in engine and the shared API client",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@app/core": "workspace:*",
    "@app/native-auth": "workspace:*",
    "@app/sdk": "workspace:*",
    "@reduxjs/toolkit": "^2.13.0",
    "react-redux": "^9.3.0"
  },
  "peerDependencies": {
    "react": ">=19.2.0",
    "react-native": ">=0.86.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.2",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.6",
    "react": "19.3.0",
    "react-native": "0.87.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": "12.6.0"
  },
  "packageManager": "pnpm@12.6.0"
}
