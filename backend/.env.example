# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Application Environment
# Options: development, production, test
NODE_ENV=development

# Server Port
# Default: 5001
PORT=5001

# MongoDB Connection URI
# Local: mongodb://localhost:27017/authboiler?replicaSet=rs0
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/database
MONGO_URI=mongodb://localhost:27017/authboiler?replicaSet=rs0

# Frontend URL (for CORS)
# Local: http://localhost:3000
# Production: https://yourdomain.com
CLIENT_URL=http://localhost:3000

# Rate Limiting Configuration
# TTL: Time window in seconds (default: 60)
# Limit: Max requests per TTL (default: 60)
THROTTLE_TTL=60
THROTTLE_LIMIT=60

# SMTP Configuration (for sending emails)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM=your-email@gmail.com

# Mail link templates (optional), see docs/setup/setup-mail-links.md
# A JSON object with a template for each mail that carries a link:
# emailChangeCode and magicLink. Unset, each link is CLIENT_URL plus its
# fixed path. {locale} becomes the recipient's language.
# MAIL_LINKS_CUSTOMER='{"emailChangeCode":"https://id.example.com","magicLink":"https://id.example.com/{locale}/sign-in/link"}'
# MAIL_LINKS_STAFF='{"emailChangeCode":"https://console.example.com","magicLink":"https://console.example.com"}'

# Bcrypt Configuration
# Number of rounds for password hashing (default: 10, range: 4-12)
BCRYPT_ROUNDS=10

# Session Configuration
# Cookie name for session token (default: sid)
SESSION_COOKIE_NAME=sid
# Cookie max age in milliseconds (default: 604800000 = 7 days)
SESSION_COOKIE_MAX_AGE=604800000
# Deployment auth epoch. Advance outside database restores. Default: 1
AUTH_EPOCH=1
# Native credential issuance. Default: false
AUTH_NATIVE_ENABLED=false
# Require DPoP-bound token pairs after clients have upgraded. Default: false.
AUTH_NATIVE_DPOP_REQUIRED=false
# HMAC secret for DPoP nonce generation. Required when native sign-in is enabled.
# Generate with: openssl rand -hex 32
AUTH_NATIVE_DPOP_NONCE_SECRET=
# Public origin of this API, as native clients reach it. Required when native
# sign-in is enabled: DPoP proofs are checked against it. http or https, no
# path, query or fragment (not .../api), and https when NODE_ENV=production.
# API_URL=https://api.example.com
# JSON array of native clients. allowedScopes may be omitted or exactly ["api"],
# the only scope: it grants the user's full permissions. Anything else stops startup.
# With native sign-in on, an unset or empty list disables every native application and signs its users out.
# AUTH_NATIVE_APPLICATIONS='[{"clientId":"com.example.mobile","displayName":"Example Mobile","redirectUris":["com.example.mobile://oauth/callback"]}]'
# Custom-scheme native callbacks (myapp://...) in production. Default: false.
# Outside production custom schemes are always accepted. In production they are
# accepted only when this is true; https and loopback http callbacks always work.
# AUTH_NATIVE_ALLOW_CUSTOM_SCHEME=false

# Signs OAuth state cookies and passkey challenge cookies. Required when
# OAuth or passkeys are enabled. Generate with: openssl rand -base64 48
OAUTH_STATE_SECRET=change-me-to-a-random-48-byte-base64url-secret

# Activation Code Configuration
# Code expiry time in milliseconds (default: 900000 = 15 minutes)
ACTIVATION_CODE_EXPIRES_IN=900000
# Maximum activation attempts before code invalidation (default: 5)
ACTIVATION_MAX_ATTEMPTS=5

# Password Sign-In
# Set to false to turn off register, login, forgot-password and reset-password.
# Those routes then answer 404 with FEATURE_DISABLED (default: true)
AUTH_PASSWORD_ENABLED=true

# Magic Link Sign-In - needs SMTP_HOST and EMAIL_FROM, see docs/setup/setup-magic-link.md
# MAGIC_LINK_ENABLED=true
# Magic link lifetime in milliseconds (default: 900000 = 15 minutes)
MAGIC_LINK_EXPIRES_IN=900000
# Magic links mailed to one address per hour (default: 5)
MAGIC_LINK_MAX_PER_HOUR=5

# TOTP Two-Factor - see docs/setup/setup-two-factor.md
# Set to false to close the /auth/2fa routes; accounts then sign in with one
# factor even if they had a second one (default: true)
TWO_FACTOR_ENABLED=true
# 32 bytes of base64, from `openssl rand -base64 32`. Encrypts TOTP secrets at
# rest and signs the login challenge cookie. Without it the 2FA routes answer
# 503 TWO_FACTOR_NOT_CONFIGURED; the rest of the application still starts.
# Changing it makes every enrolled authenticator app unusable.
# TOTP_ENCRYPTION_KEY=
# TOTP_ENCRYPTION_KEY_PREVIOUS=

# Passkeys (WebAuthn) - see docs/setup/setup-passkeys.md
# Set to false to close the /auth/passkeys routes (default: true)
PASSKEYS_ENABLED=true
# Domain the credentials are bound to. Defaults to the hostname of CLIENT_URL.
# A bare hostname: no scheme, no port. Changing it invalidates every passkey.
# WEBAUTHN_RP_ID=localhost
# Name the browser shows in the passkey prompt (default: the app name)
# WEBAUTHN_RP_NAME=Auth App
# PASSKEY_CHALLENGE_SECRET=
# PASSKEY_CHALLENGE_SECRET_PREVIOUS=
# PASSKEY_CHALLENGE_LEGACY_UNTIL=
# Origin the browser has to be on, scheme and port included. Defaults to the
# origin of CLIENT_URL. Production needs https.
# WEBAUTHN_ORIGIN=http://localhost:3000

# Profile Synchronization
# Enable automatic profile synchronization from OAuth providers (default: true)
PROFILE_SYNC_ENABLED=true
# Profile fields to sync from OAuth providers (default: name,picture)
PROFILE_SYNC_FIELDS=name,picture

# OAuth Configuration (all providers are optional)
# A provider is auto-enabled once its CLIENT_ID and CLIENT_SECRET are set. CALLBACK_URL
# is optional; without it the URL is derived from OAUTH_CALLBACK_BASE_URL. Apple is the
# exception: it has no client secret and needs its team id, key id and private key.
# Leave commented out to disable a provider.

# Google OAuth (optional)
# OAUTH_GOOGLE_CLIENT_ID=your-google-oauth-client-id
# OAUTH_GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# OAUTH_GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/oauth/google/callback

# Facebook OAuth (optional)
# OAUTH_FACEBOOK_CLIENT_ID=your-facebook-oauth-client-id
# OAUTH_FACEBOOK_CLIENT_SECRET=your-facebook-oauth-client-secret
# OAUTH_FACEBOOK_CALLBACK_URL=http://localhost:5000/api/auth/oauth/facebook/callback

# GitHub OAuth (optional)
# OAUTH_GITHUB_CLIENT_ID=your-github-oauth-client-id
# OAUTH_GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
# OAUTH_GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/oauth/github/callback

# Microsoft OAuth (optional) - see docs/setup/setup-microsoft-oauth.md
# OAUTH_MICROSOFT_CLIENT_ID=your-entra-application-client-id
# OAUTH_MICROSOFT_CLIENT_SECRET=your-entra-client-secret
# OAUTH_MICROSOFT_CALLBACK_URL=http://localhost:5000/api/auth/oauth/microsoft/callback
# Tenant segment of the authorize and token URLs. 'common' accepts work, school
# and personal accounts; a tenant id limits sign-in to one organisation.
# OAUTH_MICROSOFT_TENANT=common

# Apple OAuth (optional) - see docs/setup/setup-apple-oauth.md
# Apple refuses localhost redirect URIs, so this one only works behind HTTPS.
# There is no client secret: the backend signs a short lived one with the .p8 key.
# OAUTH_APPLE_CLIENT_ID=com.example.web
# OAUTH_APPLE_CALLBACK_URL=https://your-domain.com/api/auth/oauth/apple/callback
# OAUTH_APPLE_TEAM_ID=your-10-character-team-id
# OAUTH_APPLE_KEY_ID=your-10-character-key-id
# Contents of the .p8 file on one line, newlines written as \n
# OAUTH_APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----\n

# Discord OAuth (optional) - see docs/setup/setup-discord-oauth.md
# OAUTH_DISCORD_CLIENT_ID=your-discord-application-id
# OAUTH_DISCORD_CLIENT_SECRET=your-discord-client-secret
# OAUTH_DISCORD_CALLBACK_URL=http://localhost:5000/api/auth/oauth/discord/callback

# LinkedIn OAuth (optional) - see docs/setup/setup-linkedin-oauth.md
# Needs the "Sign In with LinkedIn using OpenID Connect" product on the app.
# OAUTH_LINKEDIN_CLIENT_ID=your-linkedin-client-id
# OAUTH_LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
# OAUTH_LINKEDIN_CALLBACK_URL=http://localhost:5000/api/auth/oauth/linkedin/callback

# GitLab OAuth (optional) - see docs/setup/setup-gitlab-oauth.md
# OAUTH_GITLAB_CLIENT_ID=your-gitlab-application-id
# OAUTH_GITLAB_CLIENT_SECRET=your-gitlab-application-secret
# OAUTH_GITLAB_CALLBACK_URL=http://localhost:5000/api/auth/oauth/gitlab/callback
# Root of the instance. Point it at your own host for a self-managed GitLab.
# OAUTH_GITLAB_BASE_URL=https://gitlab.com

# X OAuth (optional) - see docs/setup/setup-x-oauth.md
# Needs a confidential OAuth 2.0 client, and the address only comes back with
# the users.email scope, which has to be enabled on the app.
# OAUTH_X_CLIENT_ID=your-x-client-id
# OAUTH_X_CLIENT_SECRET=your-x-client-secret
# OAUTH_X_CALLBACK_URL=http://localhost:5000/api/auth/oauth/x/callback

# Slack OAuth (optional) - see docs/setup/setup-slack-oauth.md
# Uses "Sign in with Slack", which is separate from a bot token app.
# OAUTH_SLACK_CLIENT_ID=your-slack-client-id
# OAUTH_SLACK_CLIENT_SECRET=your-slack-client-secret
# OAUTH_SLACK_CALLBACK_URL=http://localhost:5000/api/auth/oauth/slack/callback

# Twitch OAuth (optional) - see docs/setup/setup-twitch-oauth.md
# OAUTH_TWITCH_CLIENT_ID=your-twitch-client-id
# OAUTH_TWITCH_CLIENT_SECRET=your-twitch-client-secret
# OAUTH_TWITCH_CALLBACK_URL=http://localhost:5000/api/auth/oauth/twitch/callback

# Generic OpenID Connect (optional) - see docs/setup/setup-oidc-oauth.md
# Endpoints are read from {issuer}/.well-known/openid-configuration once at
# startup. An unreachable issuer leaves this provider off; it does not stop the
# boot.
# OAUTH_OIDC_ISSUER=https://sso.example.com
# OAUTH_OIDC_CLIENT_ID=your-client-id
# OAUTH_OIDC_CLIENT_SECRET=your-client-secret
# OAUTH_OIDC_CALLBACK_URL=http://localhost:5000/api/auth/oauth/oidc/callback
# Route segment and the name stored on linked accounts. Changing it after users
# have signed in orphans their links.
# OAUTH_OIDC_PROVIDER_ID=oidc
# OAUTH_OIDC_DISPLAY_NAME=Single sign-on
# OAUTH_OIDC_SCOPES=openid profile email
# Set all four to skip discovery, for an issuer that publishes no document.
# OAUTH_OIDC_AUTHORIZATION_URL=https://sso.example.com/authorize
# OAUTH_OIDC_TOKEN_URL=https://sso.example.com/token
# OAUTH_OIDC_USERINFO_URL=https://sso.example.com/userinfo
# OAUTH_OIDC_JWKS_URL=https://sso.example.com/jwks

# Swagger API Documentation
# Enable Swagger UI (default: false)
SWAGGER_ENABLED=false

# Database Seeding (optional password overrides)
# If omitted, random base64url passwords are generated during seeding
# SEED_ADMIN_PASSWORD=your-custom-admin-password
# SEED_USER_PASSWORD=your-custom-user-password
# DATABASE_TYPE=mongodb
# POSTGRES_URL=postgres://authboiler:change-me@localhost:5432/authboiler
# POSTGRES_POOL_MAX=10

# Reserved host settings. These do not change routes, guards or jobs today.
# Used from plan 1. Optional admin origin, distinct from CLIENT_URL.
# ADMIN_URL=
# Used from plan 1. Reserved web application switch.
AUTH_WEB_ENABLED=true
# Used from plan 1. Optional method flags and signUp, requirePasskey, audience JSON.
# AUTH_WEB_SIGN_IN=
# Used from plan 1. Optional method flags and signUp, requirePasskey, audience JSON.
# AUTH_ADMIN_SIGN_IN=
# Used from plan 1. Optional absoluteHours, idleMinutes, cap JSON.
# AUTH_WEB_SESSION=
# Used from plan 1. Optional absoluteHours, idleMinutes, cap JSON.
# AUTH_ADMIN_SESSION=
# Used from plan 1. Optional bare hostname for native association links.
# AUTH_NATIVE_LINK_HOST=
# Used from plan 2. Email-code sign-in for native apps. Each application also needs signIn.emailCode.
EMAIL_CODE_ENABLED=false
# Used from plan 2. Email code lifetime in milliseconds, ten minutes by default. Never longer than the attempt.
EMAIL_CODE_EXPIRES_IN=600000
# Used from plan 2. Optional email code review account, all four review fields or none.
# EMAIL_CODE_REVIEW_ACCOUNT_ID=
# Used from plan 2. Optional email code review application.
# EMAIL_CODE_REVIEW_CLIENT_ID=
# Used from plan 2. Optional bcrypt hash of the fixed six-digit review code, never the code.
# EMAIL_CODE_REVIEW_CODE_HASH=
# Used from plan 2. Optional email code ISO timestamp, at most 30 days ahead.
# EMAIL_CODE_REVIEW_UNTIL=
# Used from plan 4. Reserved staff activity retention. Existing events keep 90 days.
ACTIVITY_RETENTION_DAYS=730
# Used from plan 4. Invitations lifetime in milliseconds, seven days by default.
INVITATION_EXPIRES_IN=604800000
# Used from plan 4. Reserved strict mutation switch.
ADMIN_STRICT_MUTATIONS=false
# Used from plan 5. Unset disables erasure, zero means immediate erasure once implemented.
# ACCOUNT_ERASE_GRACE_DAYS=
# Used from plan 5. Optional secret provider-token encryption key.
# PROVIDER_TOKEN_ENCRYPTION_KEY=
# Used from plan 5. Optional previous secret key during rotation.
# PROVIDER_TOKEN_ENCRYPTION_KEY_PREVIOUS=
