{
  "name": "backend",
  "version": "0.0.1",
  "description": "AuthStack Starter API with configurable authentication, session management, and roles and permissions",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": "^22.12.0 || ^24.22.0",
    "pnpm": "12.6.0"
  },
  "scripts": {
    "build": "nest build && node ../scripts/check-backend-build.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "node ./test/run-jest.mjs",
    "test:watch": "node ./test/run-jest.mjs --watch",
    "test:cov": "node ./test/run-jest.mjs --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "node ./test/run-jest.mjs --config ./test/jest-e2e.json --runInBand",
    "test:e2e:postgres": "node ./test/run-jest.mjs --config ./test/jest-e2e-postgres.json --runInBand",
    "ci": "pnpm run lint && pnpm run build && pnpm run test",
    "migration:create": "migrate-mongo create",
    "migration:up": "migrate-mongo up",
    "migration:down": "migrate-mongo down",
    "migration:status": "migrate-mongo status",
    "migration:postgres:up": "ts-node -r tsconfig-paths/register src/common/persistence/postgres/postgres-migrate.cli.ts up",
    "migration:postgres:status": "ts-node -r tsconfig-paths/register src/common/persistence/postgres/postgres-migrate.cli.ts status",
    "migration:postgres:adopt-host": "ts-node -r tsconfig-paths/register src/common/persistence/postgres/postgres-migrate.cli.ts adopt-host",
    "audience:apply": "node dist/cli/audience-apply.js",
    "admin:invite": "node dist/cli/admin-invite.js",
    "admin:recover": "node dist/cli/admin-recover.js",
    "audience:apply:dev": "ts-node -r tsconfig-paths/register src/cli/audience-apply.ts",
    "seed": "ts-node -r tsconfig-paths/register src/database/seeds/index.ts",
    "seed:reset": "ts-node -r tsconfig-paths/register src/database/seeds/index.ts --reset",
    "auth:access": "node ../shared/core/scripts/auth-access.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@simplewebauthn/server": "^14.0.3",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "jose": "^6.2.13",
    "kysely": "0.29.7",
    "mongoose": "^8.24.4",
    "nodemailer": "^10.2.1",
    "otplib": "^13.5.0",
    "pg": "8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "express": "5.3.0",
    "mongodb": "6.20.0"
  },
  "devDependencies": {
    "@app/native-auth": "workspace:*",
    "@app/sdk": "workspace:*",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.3",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.2",
    "@types/nodemailer": "^7.0.12",
    "@types/pg": "8.23.1",
    "@types/supertest": "^7.2.1",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "migrate-mongo": "^14.0.7",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "globalSetup": "<rootDir>/../test/utils/mongo/mongo-global-setup.ts",
    "globalTeardown": "<rootDir>/../test/utils/mongo/mongo-global-teardown.ts",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": {
            "allowJs": true,
            "isolatedModules": true
          }
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.*/)?(jose|@scure/base|@noble/hashes|@simplewebauthn|@nestjs/mongoose|kysely)/)"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
