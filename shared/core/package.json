{
  "name": "@app/core",
  "version": "0.1.0",
  "description": "Platform-neutral rules and types shared by the web and mobile clients",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./errors": "./src/errors.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "errors": [
        "./src/errors.ts"
      ]
    }
  },
  "sideEffects": false,
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "auth:access": "node scripts/auth-access.mjs"
  },
  "peerDependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": "^22.12.0 || ^24.22.0",
    "pnpm": "12.6.0"
  }
}
